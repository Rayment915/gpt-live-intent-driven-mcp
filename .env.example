AZURE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
AZURE_SUBSCRIPTION_ID=YOUR-SUBSCRIPTION-ID
LIVE_DEPLOYMENT=gpt-live-1
RESPONSES_DEPLOYMENT=gpt-6-luna
DECISION_DEPLOYMENT=ms-d-1
# Leave empty for Azure CLI / managed identity authentication.
AZURE_API_KEY=
MCP_FAQ_URL=http://127.0.0.1:8101/mcp
MCP_REPAIR_URL=http://127.0.0.1:8102/mcp
MCP_VERIFICATION_URL=http://127.0.0.1:8103/mcp
MCP_FAQ_KEY=
MCP_REPAIR_KEY=
MCP_VERIFICATION_KEY=
# Required for cloud MCP. DefaultAzureCredential must have Storage Table Data Contributor.
TABLE_ENDPOINT=
TABLE_NAME=LiveDemo
# Local offline development only: explicitly set STATE_BACKEND=sqlite
STATE_BACKEND=table
SQLITE_PATH=.build/demo.sqlite
INTENT_THRESHOLD=0.70
MCP_CATALOG_TTL_SECONDS=300
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=4
# Loopback-only development may disable auth explicitly; hosted containers require it.
AUTH_REQUIRED=false
AUTH_USERNAME=admin
# Generate privately with scripts/configure_studio_login.py; never put the password here.
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECONDS=28800
APP_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
